{
    "version": 2,
    "buildCommand": "cd frontend && npm ci --include=dev && npm run build:railway",
    "outputDirectory": "frontend/dist/pielak-web/browser",
    "installCommand": "cd frontend && npm ci --include=dev",
    "functions": {
        "api/server.js": {
            "memory": 512,
            "maxDuration": 10,
            "includeFiles": "frontend/server/bd.json"
        }
    },
    "redirects": [
        {
            "source": "/dev",
            "destination": "https://servicos.maiawall.com",
            "permanent": true
        },
        {
            "source": "/dev/:path*",
            "destination": "https://servicos.maiawall.com/:path*",
            "permanent": true
        }
    ],
    "rewrites": [
        {
            "source": "/api/:path*",
            "destination": "/api/server.js"
        },
        {
            "source": "/((?!.*\\..*).*)",
            "destination": "/index.html"
        }
    ],
    "headers": [
        {
            "source": "/api/(.*)",
            "headers": [
                {
                    "key": "Access-Control-Allow-Origin",
                    "value": "*"
                },
                {
                    "key": "Access-Control-Allow-Methods",
                    "value": "GET,POST,PUT,PATCH,DELETE,OPTIONS"
                },
                {
                    "key": "Access-Control-Allow-Headers",
                    "value": "Content-Type, Authorization"
                }
            ]
        },
        {
            "source": "/assets/(.*)",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=31536000, immutable"
                }
            ]
        }
    ]
}
